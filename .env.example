# Beyond 80 Environment Configuration
APP_ENV=development
PORT=8000
HOST=127.0.0.1
DEFAULT_TIMEZONE=Asia/Karachi
DEFAULT_APPROVAL_MODE=REQUIRED_APPROVAL

# Storage Configuration
DATA_DIR=output/platform_db
OUTPUT_DIR=output

# Publishing Integrations (Simulated by default; provide genuine OAuth credentials only when authorized)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
INSTAGRAM_ACCESS_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
FACEBOOK_PAGE_ACCESS_TOKEN=

# LLM Providers (Optional - Local mock / rule engine active by default)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
