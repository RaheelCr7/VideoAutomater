# VideoAutomater Configuration

# Google Gemini API Key (Free tier supported: https://aistudio.google.com/)
GEMINI_API_KEY=

# Default Video Configuration
DEFAULT_DURATION=80
DEFAULT_ASPECT_RATIO=9:16
DEFAULT_WIDTH=1080
DEFAULT_HEIGHT=1920
DEFAULT_FPS=30

# Output & Logging
OUTPUT_DIR=output
LOG_LEVEL=INFO
APP_TIMEZONE=Asia/Karachi

# Edge TTS Narrator Voice (e.g. en-US-ChristopherNeural, en-US-GuyNeural, en-GB-RyanNeural)
TTS_VOICE=en-US-ChristopherNeural

# Review Policy (AUTO_PUBLISH | OPTIONAL_REVIEW | REQUIRED_APPROVAL)
DEFAULT_REVIEW_POLICY=OPTIONAL_REVIEW
